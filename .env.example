# Database Connection (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://sfmp_user:sfmp_dev_password@localhost:5432/sfmp_db

# Cache & Rate Limiting (Redis 7)
REDIS_URL=redis://:redis_dev_password@localhost:6379/0

# Security & Authentication
# Generate a strong 256-bit secret using: openssl rand -hex 32
JWT_SECRET_KEY=dev_jwt_secret_key_change_in_production_min_32_bytes_long!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set true when serving over HTTPS in production
COOKIE_SECURE=false

# File Storage Configuration
STORAGE_ROOT=/var/lib/sfmp_vault

# File Size Limits & User Quotas (in Bytes)
# Default Max Upload Size: 25 MB
MAX_FILE_SIZE_BYTES=26214400
# Default User Storage Quota: 1 GB (1,073,741,824 bytes)
DEFAULT_USER_QUOTA_BYTES=1073741824

# CORS & Allowed Origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080

# Environment Mode
ENVIRONMENT=development
